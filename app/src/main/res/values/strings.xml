<resources>
    <string name="app_name">Pauta</string>

    <!-- Tela de preparo dos modelos -->
    <string name="setup_title">Preparar transcrição local</string>
    <string name="setup_body">Para transcrever sem enviar nada para a nuvem, o app instala os modelos no aparelho (uma única vez):\n\n• Parakeet TDT 0.6B v3 (int8) — transcrição em 25 idiomas, incluindo português (~487 MB)\n• Silero VAD — detecção de fala (~0,6 MB)\n\nRecomendamos Wi-Fi. Depois de instalados, tudo funciona offline.</string>
    <string name="setup_download">Baixar e instalar modelos</string>
    <string name="setup_downloading">Baixando %1$s… %2$s</string>
    <string name="setup_extracting">Extraindo modelo (~1–3 min)…</string>
    <string name="setup_error">Falha na instalação</string>
    <string name="setup_retry">Tentar de novo</string>
    <string name="setup_privacy_note">Privacidade: seus áudios e transcrições nunca saem do aparelho. A conexão é usada apenas agora, para baixar os modelos oficiais (com verificação de checksum).</string>
    <string name="setup_space_warning">Espaço livre insuficiente: são necessários ~2 GB livres durante a instalação.</string>

